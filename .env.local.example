# ── Resend (transactional email) ────────────────────────────────────────
# Required for the package inquiry and contact forms to actually deliver
# emails to liam.costello@primara365.com. Until these are set, form submissions
# still return "success" to the user but the email content is only logged
# to the server console (so the form is usable for visual testing).
#
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Create an API key → copy here
# 3. Verify a sender domain (or use the default onboarding@resend.dev for
#    testing — it can only send to your own verified email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Primara <hello@primara.com>

# Optional — set if you want replies to inquiries to go to a specific
# inbox rather than the form sender's email
# RESEND_REPLY_TO=liam.costello@primara365.com

# ── Public site config ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://primara.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=primara.com
